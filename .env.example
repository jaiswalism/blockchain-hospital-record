# Ethereum Network & Node RPC Configuration (Defaults to public Sepolia RPC if left blank)
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Deployer Account Credentials (DO NOT COMMIT REAL KEYS)
# Recommended: Export private key from MetaMask for a test account:
DEPLOYER_PRIVATE_KEY=your_private_key_here

# Alternatively, deployer 12-word seed phrase:
# DEPLOYER_MNEMONIC="twelve secret words of deployer metamask wallet phrase here"

# Deployed Smart Contract Address
NEXT_PUBLIC_CONTRACT_ADDRESS=0x876a8101E934d032EAB97aA800f03159A60b327E
